# GEMINI_API_KEY: Required for Gemini AI API calls on the server BFF.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FASTAPI_BACKEND_URL: Internal server-side FastAPI Business Backend URL (never exposed to browser).
# Leave empty to run in explicit Demo/Simulation mode.
FASTAPI_BACKEND_URL=

# API_MODE: "demo" or "live"
API_MODE=demo
